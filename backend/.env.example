# ==========================================
# Daarick Systems // AI Gateway Configuration
# ==========================================

# 1. Google Gemini (Tu suscripción Google AI Pro)
# Pega tu API Key de Google AI Studio (https://aistudio.google.com/app/apikey):
GEMINI_API_KEY=

# Modelos de Google AI:
# - Modelo rápido y económico para respuestas ágiles y reescritura guiada:
GEMINI_FAST_MODEL=gemini-1.5-flash

# - Modelo avanzado de razonamiento profundo para análisis de arquitectura y viabilidad:
GEMINI_HEAVY_MODEL=gemini-1.5-pro

# 2. OpenRouter (Opcional, para Jev router de decisiones u otros proveedores)
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_ROUTER_MODEL=typesafe/jev
