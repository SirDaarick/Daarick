# ==========================================
# Daarick Systems // AI Gateway Configuration
# ==========================================

# 1. OpenRouter Configuration
# Consigue tu API Key en: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Modelo para Jev / Router de Decisiones (System One)
OPENROUTER_ROUTER_MODEL=typesafe/jev

# Modelo ligero y económico para preguntas simples y reescritura de respuestas
# Opciones recomendadas:
# - google/gemini-2.0-flash-lite:free
# - meta-llama/llama-3.1-8b-instruct
# - google/gemini-flash-1.5
OPENROUTER_CHEAP_MODEL=google/gemini-2.0-flash-lite:free

# 2. Google Gemini Direct Configuration (Opcional para razonamiento complejo)
# Si deseas usar la API directa de Google AI Studio para el modelo pesado:
GEMINI_API_KEY=
GEMINI_HEAVY_MODEL=gemini-1.5-pro
