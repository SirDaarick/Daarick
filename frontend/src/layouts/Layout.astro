---
import '../styles/global.css';
import { AsciiCanvas } from '../components/AsciiCanvas';
import { SandboxModal } from '../components/SandboxModal';
import { RoiCalculatorModal } from '../components/RoiCalculatorModal';
import { CopilotAssistant } from '../components/CopilotAssistant';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  quietBackground?: boolean;
}

const {
  title = "Daarick // Sistemas de IA & Automatización",
  description = "Ingeniero de Sistemas de IA & Automatización. Arquitecturas autónomas, limpias y deterministas con FastAPI, Python y React.",
  quietBackground = false
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
          
          function applyTheme(isDark) {
            if (isDark) {
              document.documentElement.classList.add('dark');
              document.documentElement.classList.remove('light');
            } else {
              document.documentElement.classList.remove('dark');
              document.documentElement.classList.add('light');
            }
          }

          if (stored) {
            applyTheme(stored === 'dark');
          } else {
            applyTheme(mediaQuery.matches);
          }

          // Escuchar cambios en la preferencia del sistema operativo si no se ha forzado manualmente
          mediaQuery.addEventListener('change', (e) => {
            if (!localStorage.getItem('theme')) {
              applyTheme(e.matches);
            }
          });
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="bg-[var(--color-canvas-base,#160B1A)] font-sans text-[var(--color-text-ivory,#F8F4E9)] min-h-screen relative selection:bg-[#c084fc] selection:text-[#500989] overflow-x-hidden">
    {/* Subtle Grid Pattern Background */}
    <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden opacity-10">
      <div class="absolute inset-0 bg-[radial-gradient(#ddb8ff_1px,transparent_1px)] [background-size:24px_24px]"></div>
    </div>

    {/* Ambient Interactive ASCII Background Canvas */}
    {!quietBackground && <AsciiCanvas client:load />}

    {/* Ambient Glow Spheres */}
    {!quietBackground && (
      <>
        <div class="pointer-events-none absolute top-12 left-1/4 w-96 h-96 bg-[#c084fc]/10 rounded-full blur-3xl z-0"></div>
        <div class="pointer-events-none absolute top-96 right-10 w-80 h-80 bg-[rgba(113,52,85,0.2)] rounded-full blur-3xl z-0"></div>
      </>
    )}

    <Navbar />

    <main class="relative z-10 w-full pt-16 bg-transparent">
      <slot />
    </main>

    <Footer />

    {/* Interactive Modal Island (Loaded Immediately to catch custom events) */}
    <SandboxModal client:load />

    {/* Interactive ROI & Pricing Calculator Modal */}
    <RoiCalculatorModal client:load />

    {/* Floating AI Copilot Assistant (Loaded Immediately on Load) */}
    <CopilotAssistant client:load />
  </body>
</html>
