---
import Layout from '../layouts/Layout.astro';
import { RoiCalculatorModal } from '../components/RoiCalculatorModal';
---

<Layout
  title="Cotizador & Retorno de Inversión (ROI) // Daarick"
  description="Calcula cuánto cuesta automatizar los procesos de tu negocio y el retorno de inversión proyectado a 12 meses."
  quietBackground={true}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8">
    {/* Encabezado editorial adaptable a modo claro y oscuro */}
    <div class="space-y-2 print:hidden">
      <a href="/" class="inline-flex items-center gap-1.5 text-xs font-mono text-[#7e22ce] dark:text-[#c084fc] hover:underline transition-colors">
        ← Volver al portafolio
      </a>
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white tracking-tight">
        Cotizador & Retorno de Inversión
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-[#F6DBC0]/70 max-w-2xl leading-relaxed">
        Selecciona las soluciones para tu negocio y descubre cuánto tiempo y dinero puedes recuperar mes a mes.
      </p>
    </div>

    {/* Componente principal de cálculo con arquitectura adaptable */}
    <RoiCalculatorModal client:load mode="page" />
  </div>
</Layout>
