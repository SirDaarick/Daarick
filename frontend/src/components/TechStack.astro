---
// TechStack.astro
const PILLARS = [
  {
    title: "Inteligencia Artificial y Agentes",
    description: "Modelos autónomos para procesar documentos, razonar flujos y ejecutar tareas sin alucinaciones.",
    borderColor: "hover:border-[#c084fc]/50",
    badgeBg: "bg-[rgba(192,132,252,0.15)] text-[#c084fc]",
    tools: [
      { name: "LangChain", icon: "/icons/langchain.svg" },
      { name: "LangGraph", icon: "/icons/langgraph.svg" },
      { name: "Python", icon: "/icons/python.svg" },
      { name: "PyTorch", icon: "/icons/pytorch.svg" },
      { name: "Hugging Face", icon: "/icons/huggingface.svg" }
    ]
  },
  {
    title: "Automatización y Lógica Rápida",
    description: "Motores que conectan sistemas, procesan información masiva y ejecutan tareas repetitivas en milisegundos.",
    borderColor: "hover:border-emerald-500/50",
    badgeBg: "bg-emerald-500/15 text-emerald-400",
    tools: [
      { name: "Python", icon: "/icons/python.svg" },
      { name: "FastAPI", icon: "/icons/fastapi.svg" },
      { name: "C++", icon: "/icons/cplusplus.svg" },
      { name: "Docker", icon: "/icons/docker.svg" }
    ]
  },
  {
    title: "Interfaces y Experiencia de Usuario",
    description: "Paneles web intuitivos y claros donde cualquier miembro de tu equipo puede operar el sistema sin complicaciones.",
    borderColor: "hover:border-sky-500/50",
    badgeBg: "bg-sky-500/15 text-sky-400",
    tools: [
      { name: "React", icon: "/icons/react.svg" },
      { name: "Astro", icon: "/icons/astro.svg" },
      { name: "TypeScript", icon: "/icons/typescript.svg" },
      { name: "Tailwind CSS", icon: "/icons/tailwindcss.svg" }
    ]
  },
  {
    title: "Bases de Datos y Servidores Seguros",
    description: "Almacenamiento protegido e infraestructura configurada para garantizar disponibilidad continua y confidencialidad.",
    borderColor: "hover:border-amber-400/50",
    badgeBg: "bg-amber-500/15 text-amber-300",
    tools: [
      { name: "PostgreSQL", icon: "/icons/postgresql.svg" },
      { name: "Supabase", icon: "/icons/supabase.svg" },
      { name: "Docker", icon: "/icons/docker.svg" },
      { name: "Vercel", icon: "/icons/vercel.svg" }
    ]
  }
];
---

<section class="flex flex-col gap-5" id="habilidades">
  {/* Header Limpio */}
  <div class="flex flex-col gap-1 max-w-2xl">
    <span class="font-mono text-xs text-[#c084fc] font-medium tracking-wide">
      [ Herramientas y Tecnologías ]
    </span>
    <h2 class="text-2xl sm:text-3xl font-semibold text-[#F8F4E9] tracking-tight">
      Cómo construyo las soluciones
    </h2>
  </div>

  {/* 4 Pillars Grid */}
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-1">
    {PILLARS.map((pillar) => (
      <div class={`flex flex-col justify-between p-5 rounded-2xl bg-[rgba(32,19,36,0.65)] border border-[rgba(147,80,115,0.25)] ${pillar.borderColor} transition-all`}>
        <div class="flex flex-col gap-2.5">
          <h3 class="text-base font-semibold text-[#F8F4E9]">
            {pillar.title}
          </h3>
          <p class="text-xs text-[#F6DBC0] leading-relaxed">
            {pillar.description}
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-[rgba(147,80,115,0.2)] flex items-center gap-2 flex-wrap">
          {pillar.tools.map((tool) => (
            <div
              class="group relative flex items-center justify-center w-9 h-9 p-2 rounded-xl bg-[rgba(26,15,30,0.85)] border border-[rgba(147,80,115,0.3)] hover:border-[#c084fc] hover:bg-[rgba(45,20,55,0.9)] transition-all cursor-pointer shadow-sm"
              title={tool.name}
            >
              <img
                src={tool.icon}
                alt={tool.name}
                class="w-4 h-4 object-contain"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
