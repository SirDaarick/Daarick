---
// Navbar.astro
---

<header class="fixed top-0 left-0 right-0 z-40 bg-[rgba(26,15,30,0.85)] backdrop-blur-xl border-b border-[rgba(147,80,115,0.3)] shadow-[0_1px_8px_rgba(0,0,0,0.3)]">
  <div class="h-16 max-w-7xl mx-auto px-4 lg:px-8 flex items-center justify-between">
    <a href="/" class="font-mono text-sm text-[#ddb8ff] tracking-wider transition-colors hover:text-[#D8B4FE] flex items-center gap-1.5">
      <span class="text-[#c084fc] font-semibold">[daarick@systems:~]$</span>
      <span class="animate-pulse text-[#10B981]">_</span>
    </a>

    <div class="flex items-center gap-3">
      <nav class="flex items-center gap-2">
        <a
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg bg-[rgba(80,45,85,0.24)] hover:bg-[rgba(80,45,85,0.38)] border border-[rgba(147,80,115,0.3)] text-[#F6DBC0] hover:text-[#F8F4E9] transition-colors flex items-center gap-1.5 font-mono text-xs"
          title="GitHub"
        >
          <svg class="w-4 h-4 fill-current text-[#ddb8ff]" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path>
          </svg>
          <span class="hidden md:inline">GitHub</span>
        </a>

        <a
          href="https://linkedin.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg bg-[rgba(80,45,85,0.24)] hover:bg-[rgba(80,45,85,0.38)] border border-[rgba(147,80,115,0.3)] text-[#F6DBC0] hover:text-[#F8F4E9] transition-colors flex items-center gap-1.5 font-mono text-xs"
          title="LinkedIn"
        >
          <svg class="w-4 h-4 fill-current text-[#c084fc]" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
          </svg>
          <span class="hidden md:inline">LinkedIn</span>
        </a>

        <a
          href="mailto:daarick@systems.local"
          class="p-2 rounded-lg bg-[rgba(80,45,85,0.24)] hover:bg-[rgba(80,45,85,0.38)] border border-[rgba(147,80,115,0.3)] text-[#F6DBC0] hover:text-[#F8F4E9] transition-colors flex items-center gap-1.5 font-mono text-xs"
          title="Contacto / Email"
        >
          <svg class="w-4 h-4 fill-current text-[#ffafd5]" viewBox="0 0 24 24">
            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"></path>
          </svg>
          <span class="hidden sm:inline">[ contacto ]</span>
        </a>
      </nav>

      <div class="w-8 h-8 rounded-full bg-[#ddb8ff]/20 border border-[#ddb8ff]/40 flex items-center justify-center shrink-0">
        <span class="font-mono text-xs text-[#ddb8ff] font-bold">D</span>
      </div>
    </div>
  </div>
</header>
