        <a
          href="https://www.linkedin.com/in/erickgarcia-ai/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg bg-[rgba(80,45,85,0.24)] hover:bg-[rgba(80,45,85,0.38)] border border-[rgba(147,80,115,0.3)] text-[#F6DBC0] hover:text-[#F8F4E9] transition-colors flex items-center gap-1.5 font-mono text-xs active:scale-95"
          title="LinkedIn de Erick"
        >
          <svg class="w-4 h-4 fill-current text-[#c084fc]" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
          </svg>
          <span class="hidden md:inline">LinkedIn</span>
        </a>

        <a
          href="https://wa.me/525578666313"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg bg-[rgba(80,45,85,0.24)] hover:bg-[rgba(80,45,85,0.38)] border border-[rgba(147,80,115,0.3)] text-[#F6DBC0] hover:text-[#F8F4E9] transition-colors flex items-center gap-1.5 font-mono text-xs active:scale-95"
          title="WhatsApp de Erick"
