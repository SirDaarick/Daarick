      </nav>

      <div class="w-8 h-8 rounded-full bg-[#ddb8ff]/20 border border-[#ddb8ff]/40 flex items-center justify-center shrink-0">
        <span class="font-mono text-xs text-[#ddb8ff] font-bold">E</span>
      </div>
    </div>
