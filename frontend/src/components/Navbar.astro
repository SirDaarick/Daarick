    <a href="/" class="font-mono text-sm text-[#ddb8ff] tracking-wider transition-colors hover:text-[#D8B4FE] flex items-center gap-1.5 shrink-0">
      <span class="text-[#c084fc] font-semibold hidden sm:inline">[daarick@systems:~]$</span>
      <span class="text-[#c084fc] font-semibold sm:hidden">[d@sys]$</span>
      <span class="animate-pulse text-[#10B981]">_</span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <nav class="flex items-center gap-1.5 sm:gap-2">
        <a
          href="https://github.com/SirDaarick"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg bg-[rgba(80,45,85,0.24)] hover:bg-[rgba(80,45,85,0.38)] border border-[rgba(147,80,115,0.3)] text-[#F6DBC0] hover:text-[#F8F4E9] transition-colors flex items-center gap-1.5 font-mono text-xs active:scale-95"
          title="GitHub de Erick"
        >
          <svg class="w-4 h-4 fill-current text-[#ddb8ff]" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path>
          </svg>
