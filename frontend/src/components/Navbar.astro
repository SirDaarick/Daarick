          <svg class="w-4 h-4 fill-current text-[#10B981]" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span class="hidden sm:inline">WhatsApp</span>
        </a>

        <a
          href="mailto:e.danielgrz10@gmail.com"
          class="p-2 rounded-lg bg-[rgba(80,45,85,0.24)] hover:bg-[rgba(80,45,85,0.38)] border border-[rgba(147,80,115,0.3)] text-[#F6DBC0] hover:text-[#F8F4E9] transition-colors flex items-center gap-1.5 font-mono text-xs active:scale-95"
          title="Contacto / Email"
        >
          <svg class="w-4 h-4 fill-current text-[#ffafd5]" viewBox="0 0 24 24">
            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"></path>
          </svg>
          <span class="hidden sm:inline">Email</span>
        </a>

        {/* Enlace Cotizador & ROI */}
        <a
          id="nav-calc-btn"
          href="/calculadora"
          class="px-2.5 py-1.5 rounded-lg bg-[rgba(192,132,252,0.18)] hover:bg-[rgba(192,132,252,0.32)] border border-[#c084fc]/50 text-[#d8b4fe] hover:text-white transition-all flex items-center gap-1.5 font-mono text-xs active:scale-95 cursor-pointer shadow-sm"
          title="Calculadora de Cotización y Retorno de Inversión"
        >
          <svg class="w-3.5 h-3.5 text-[#c084fc]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="16" height="20" x="4" y="2" rx="2"></rect>
            <line x1="8" x2="16" y1="6" y2="6"></line>
            <line x1="16" x2="16" y1="14"></line>
            <line x1="16" x2="16" y1="18"></line>
            <path d="M8 10h.01"></path>
            <path d="M12 10h.01"></path>
            <path d="M16 10h.01"></path>
            <path d="M8 14h.01"></path>
            <path d="M12 14h.01"></path>
            <path d="M8 18h.01"></path>
            <path d="M12 18h.01"></path>
          </svg>
          <span class="font-bold hidden sm:inline">Cotizador & ROI</span>
          <span class="font-bold sm:hidden">ROI</span>
        </a>

        {/* Botón de alternancia de tema (Modo Claro / Oscuro según sistema o preferencia manual) */}
        <button
          id="theme-toggle-btn"
          type="button"
          class="p-2 rounded-lg bg-[rgba(80,45,85,0.24)] hover:bg-[rgba(80,45,85,0.38)] border border-[rgba(147,80,115,0.3)] text-[#F6DBC0] hover:text-[#F8F4E9] transition-colors flex items-center justify-center font-mono text-xs active:scale-95 cursor-pointer"
          title="Cambiar tema (Claro / Oscuro)"
          aria-label="Cambiar tema"
        >
          {/* Icono Luna (Visible en modo claro) */}
          <svg id="theme-moon-icon" class="w-4 h-4 hidden fill-current text-[#702652]" viewBox="0 0 24 24">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          {/* Icono Sol (Visible en modo oscuro) */}
          <svg id="theme-sun-icon" class="w-4 h-4 block fill-current text-[#ffbd2e]" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="5"></circle>
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </button>
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  function updateThemeIcons() {
    const isLight = document.documentElement.classList.contains('light');
    const moon = document.getElementById('theme-moon-icon');
    const sun = document.getElementById('theme-sun-icon');
    if (moon && sun) {
      if (isLight) {
        moon.classList.remove('hidden');
        moon.classList.add('block');
        sun.classList.remove('block');
        sun.classList.add('hidden');
      } else {
        sun.classList.remove('hidden');
        sun.classList.add('block');
        moon.classList.remove('block');
        moon.classList.add('hidden');
      }
    }
  }

  // Sincronizar iconos en la carga
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateThemeIcons);
  } else {
    updateThemeIcons();
  }

  // Click handler
  document.getElementById('theme-toggle-btn')?.addEventListener('click', () => {
    const isCurrentlyDark = !document.documentElement.classList.contains('light');
    if (isCurrentlyDark) {
      document.documentElement.classList.remove('dark');
      document.documentElement.classList.add('light');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      document.documentElement.classList.remove('light');
      localStorage.setItem('theme', 'dark');
    }
    updateThemeIcons();
  });
</script>
