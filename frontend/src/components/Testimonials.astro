---
// Testimonials.astro
const VEREDICTOS = [
  {
    quote: "El sistema de triaje redujo de 40 minutos a 1.2 segundos la respuesta a incidencias críticas. Cero errores contables este trimestre.",
    author: "Elena M.",
    role: "Directora de Operaciones, Retail Supply",
    metric: "35h / semana ahorradas"
  },
  {
    quote: "Extrajimos más de 12.000 facturas PDF desordenadas sin una sola intervención manual. El retorno de inversión fue inmediato en el primer mes.",
    author: "Carlos R.",
    role: "Head of Logistics, Global Express",
    metric: "99.8% precisión OCR"
  },
  {
    quote: "Los agentes son deterministas y seguros. Nada de alucinaciones descontroladas; el backend en FastAPI responde como un reloj suizo a diario.",
    author: "Marcos T.",
    role: "Tech Lead & Enterprise Architect",
    metric: "<2ms latencia base"
  }
];
---

<section class="flex flex-col gap-6" id="veredictos">
  <div>
    <h2 class="text-2xl sm:text-3xl font-semibold text-[#F8F4E9]">
      Opiniones y resultados en producción
    </h2>
    <p class="text-sm text-[#F6DBC0] mt-1 max-w-xl leading-relaxed">
      Lo que dicen los equipos de compras, operaciones y finanzas que interactúan a diario con estos sistemas.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {VEREDICTOS.map((item) => (
      <div class="p-6 rounded-xl bg-[rgba(35,23,39,0.7)] border border-[rgba(147,80,115,0.3)] backdrop-blur-md flex flex-col justify-between relative group hover:border-[#c084fc]/50 transition-all duration-200">
        <div class="flex items-center justify-between pb-3 border-b border-[rgba(147,80,115,0.2)] font-mono text-xs">
          <span class="text-[#c084fc]">“</span>
          <span class="text-[#10B981] font-semibold">{item.metric}</span>
        </div>
        
        <p class="text-sm text-[#F6DBC0] italic leading-relaxed my-4">
          "{item.quote}"
        </p>

        <div class="pt-3 border-t border-[rgba(147,80,115,0.2)] flex flex-col">
          <span class="text-sm font-semibold text-[#F8F4E9]">{item.author}</span>
          <span class="text-xs text-[rgba(246,219,192,0.65)] font-mono">{item.role}</span>
        </div>
      </div>
    ))}
  </div>
</section>
